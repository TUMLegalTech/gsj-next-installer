{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsj.site/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "x-ownership": "release-fixed",
      "enum": [
        "gsj.site/1"
      ],
      "default": "gsj.site/1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "x-ownership": "site-supplied",
          "minLength": 1,
          "pattern": "^[^\u0000-\u001f\u007f]+$(?![\\s\\S])",
          "default": ""
        },
        "namespace": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])",
          "default": "gsj",
          "x-format-hint": "a lowercase name of letters, digits and dashes, 1 to 48 characters, starting with a letter"
        },
        "release": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])",
          "default": "gsj",
          "x-format-hint": "a lowercase name of letters, digits and dashes, 1 to 48 characters, starting with a letter"
        }
      },
      "required": [
        "context",
        "namespace",
        "release"
      ]
    },
    "public_url": {
      "type": "string",
      "x-ownership": "site-supplied",
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?$(?![\\s\\S])",
      "default": ""
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "login": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])",
          "x-format-hint": "a lowercase name of letters, digits and dashes, 1 to 48 characters, starting with a letter (an underscore is refused)",
          "default": "operator"
        },
        "password_file": {
          "type": "string",
          "x-ownership": "site-supplied",
          "minLength": 1,
          "default": ""
        },
        "secret": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^[a-z][a-z0-9-]{0,47}$(?![\\s\\S])",
          "default": "gsj-operator",
          "x-format-hint": "a lowercase name of letters, digits and dashes, 1 to 48 characters, starting with a letter"
        }
      },
      "required": [
        "login",
        "password_file",
        "secret"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:(?:\\.|_|__|-+)[a-z0-9]+)*)*)?$(?![\\s\\S])",
          "x-format-hint": "a registry host with an optional path prefix, such as registry.example.org/team/project: no scheme, no trailing slash, no tag or digest, and a lowercase path"
        },
        "config_file": {
          "type": "string",
          "x-ownership": "site-supplied",
          "default": ""
        },
        "pull_secret": {
          "type": "string",
          "x-ownership": "site-supplied",
          "default": ""
        }
      },
      "required": [
        "config_file",
        "pull_secret"
      ]
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^(https?://[^/@?#:\\s][^/@?#\\s]*(/[^?#\\s]*)?)?$(?![\\s\\S])",
          "default": "",
          "description": "The OpenAI-compatible base URL of the agent's model, or empty: an install with no LLM endpoint yet completes, its agent checks skipped, and the agent cannot answer until one is set (per case in the lawyer's Einstellungen, or here and `install` again)."
        },
        "model": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^([^#\\s]+)?$(?![\\s\\S])",
          "default": "",
          "description": "The model id that endpoint serves; set together with base_url, or both empty."
        },
        "context_window": {
          "type": "integer",
          "x-ownership": "site-supplied",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        },
        "output_tokens": {
          "type": "integer",
          "x-ownership": "site-supplied",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        },
        "flags": {
          "type": "array",
          "x-ownership": "site-supplied",
          "items": {
            "type": "string",
            "x-ownership": "site-supplied",
            "enum": [
              "no_think"
            ]
          },
          "uniqueItems": true,
          "default": []
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            },
            "secret": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            }
          },
          "required": [
            "file",
            "secret"
          ]
        },
        "allowed_origins": {
          "type": "array",
          "x-ownership": "site-supplied",
          "items": {
            "type": "string",
            "x-ownership": "site-supplied",
            "pattern": "^https?://[^/@?#:\\s][^/@?#\\s]*$(?![\\s\\S])"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": [
        "base_url",
        "model",
        "context_window",
        "output_tokens",
        "flags",
        "credential",
        "allowed_origins"
      ]
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^(https?://[^/@?#:\\s][^/@?#\\s]*/[^?#\\s]+)?$(?![\\s\\S])",
          "default": "",
          "description": "The complete chat-completions URL of a vision model for scanned pages, or empty: an install with no OCR endpoint completes, its scanned-page check skipped, and scanned pages are not read until one is set here and `install` runs again."
        },
        "model": {
          "type": "string",
          "x-ownership": "site-supplied",
          "minLength": 1,
          "default": "glm-ocr"
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            },
            "secret": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            }
          },
          "required": [
            "file",
            "secret"
          ]
        }
      },
      "required": [
        "url",
        "model",
        "credential"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "x-ownership": "site-supplied",
          "enum": [
            "reuse",
            "managed-local-path"
          ],
          "default": "reuse"
        },
        "class": {
          "type": "string",
          "x-ownership": "site-supplied",
          "minLength": 1,
          "default": ""
        },
        "node": {
          "type": "string",
          "x-ownership": "site-supplied",
          "default": ""
        },
        "backend_path": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^/[^.].*",
          "default": "/var/local-path-provisioner/gsj-managed"
        },
        "transfer_path": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^(/[^.].*)?$",
          "default": ""
        },
        "minimum_free_bytes": {
          "type": "integer",
          "x-ownership": "site-supplied",
          "minimum": 1073741824,
          "maximum": 109951162777600,
          "default": 21474836480
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "x-ownership": "site-supplied",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|m)?$",
              "default": "20Gi"
            },
            "existing_claim": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            }
          },
          "required": [
            "size",
            "existing_claim"
          ]
        },
        "forgejo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "x-ownership": "site-supplied",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|m)?$",
              "default": "10Gi"
            },
            "existing_claim": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            }
          },
          "required": [
            "size",
            "existing_claim"
          ]
        },
        "chroma": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "x-ownership": "site-supplied",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|m)?$",
              "default": "20Gi"
            },
            "existing_claim": {
              "type": "string",
              "x-ownership": "site-supplied",
              "default": ""
            }
          },
          "required": [
            "size",
            "existing_claim"
          ]
        }
      },
      "required": [
        "profile",
        "class",
        "node",
        "backend_path",
        "minimum_free_bytes",
        "data",
        "forgejo",
        "chroma"
      ]
    },
    "ingress": {
      "type": "object",
