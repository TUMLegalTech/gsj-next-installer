          "default": ""
        },
        "email": {
          "type": "string",
          "x-ownership": "site-supplied",
          "default": ""
        },
        "acme_server": {
          "type": "string",
          "x-ownership": "site-supplied",
          "pattern": "^https://[^\\s]+$(?![\\s\\S])",
