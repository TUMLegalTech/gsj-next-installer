{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsj.release/1",
  "title": "GSJ immutable installer release inventory",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "version",
    "core",
    "platforms",
    "images",
    "clients",
    "corpus",
    "addons",
    "model",
    "schema_asset",
    "release_base_url"
  ],
  "properties": {
    "schema": {
      "const": "gsj.release/1"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "qualification": {
      "type": "boolean"
    },
    "core": {
      "type": "object",
      "required": [
        "tag",
        "commit"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9A-Za-z._-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux/amd64",
          "linux/arm64"
        ]
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "runner",
        "mcp",
        "forgejo",
        "chroma",
        "decisionsData"
      ],
      "properties": {
        "web": {
          "$ref": "#/$defs/image"
        },
        "runner": {
          "$ref": "#/$defs/image"
        },
        "mcp": {
          "$ref": "#/$defs/image"
        },
        "forgejo": {
          "$ref": "#/$defs/image"
        },
        "chroma": {
          "$ref": "#/$defs/image"
        },
        "decisionsData": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "clients": {
      "type": "object",
      "required": [
        "helm",
        "kubectl",
        "jq"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "url",
            "sha256"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "manifest_sha256",
        "fingerprint",
        "source_sha256",
        "rows",
        "chunks"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "fingerprint": {
          "$ref": "#/$defs/hash"
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "type": "integer",
          "minimum": 1
        },
        "max_shard_chunks": {
          "type": "integer",
          "minimum": 1,
          "description": "chunks in the corpus's largest shard; the initializer holds one shard at a time"
        },
        "initializer_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "bytes the corpus initializer needs, declared by the release and enforced by the installer's preflight before the Lease"
        }
      }
    },
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traefik",
        "certManager",
        "localPath"
      ],
      "properties": {
        "traefik": {
          "$ref": "#/$defs/addon"
        },
        "certManager": {
          "$ref": "#/$defs/addon"
        },
        "localPath": {
          "$ref": "#/$defs/addon"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "revision",
        "manifest_sha256",
        "dimensions",
        "distance",
        "encoding"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "distance": {
          "const": "cosine"
        }
      }
    },
    "schema_asset": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "gsj/assets/schema_registry/snapshot.json.gz"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "release_base_url": {
      "type": "string",
      "pattern": "^(https://.*|)$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest",
        "platforms"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "addon": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "images"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^addons/[^\\\\]+$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "images": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
